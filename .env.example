# 複製為 .env；秘密留空，請自行填入，不要提交。
# REDIS_URL=redis://redis:6379/0
# APP_NAME=Voice-Notion
# DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1
SIRI_API_KEY=
TASK_ENCRYPTION_KEY=
GEMINI_API_KEY=

# 舊部署預設 Notion；選 Drive 改成 drive，未選目的地不用填憑證。
# CAPTURE_DESTINATION=notion
# CAPTURE_DATA_DIR=/data
# CAPTURE_MAX_BYTES=26214400
# CAPTURE_MAX_TEXT_CHARS=100000
# CAPTURE_TASK_TIMEOUT_SECONDS=900
# MODEL_TIMEOUT_SECONDS=60
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Drive 使用者 OAuth（drive.file）；新部署用下方 Web OAuth，舊手動連接維持相容。
DRIVE_FOLDER_ID=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
# Web OAuth: new connections use client ID/secret + exact callback, then encrypted SQLite.
# Leave DRIVE_FOLDER_ID/DRIVE_REFRESH_TOKEN blank when using Web OAuth.
DRIVE_OAUTH_REDIRECT_URI=

# LINE 通知可省略；收件需三項全填，且只收此 user 私聊。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USER_ID=

# 分類可由第一天啟用；none 不呼叫分類模型，custom 套用主題清單。
# CAPTURE_CLASSIFICATION=none
# CAPTURE_ROUTER=jev
# CAPTURE_CATEGORIES=[]
JEV_API_KEY=
# DELETION_PREVIEW_SECONDS=600
# DELETION_MAX_FILES=100
